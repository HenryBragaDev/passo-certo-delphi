unit UnitTelaProdutos;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Mask, Vcl.ExtCtrls,
  Vcl.DBCtrls, Vcl.Buttons, Vcl.Imaging.pngimage, Data.DB, Data.Win.ADODB,
  Vcl.Grids, Vcl.DBGrids;

type
  TTelaProdutos = class(TForm)
    pnlFundo: TPanel;
    lblEscrita2: TLabel;
    imgIcone: TImage;
    lblEscrita: TLabel;
    speedbtn_fechar: TSpeedButton;
    lbl_nomeUsuario: TLabel;
    imgSino: TImage;
    lblDate: TLabel;
    lblTime: TLabel;
    tmr: TTimer;
    pnlFundoCategorias: TPanel;
    lblCategorias: TLabel;
    pnlLinha: TPanel;
    shpCriarProduto: TShape;
    SpdbtnCriarProduto: TSpeedButton;
    pnlLateral: TPanel;
    pnlInicio: TPanel;
    SpdbtnInicio: TSpeedButton;
    imgInicio: TImage;
    pnlProdutos: TPanel;
    SpdbtnProdutos: TSpeedButton;
    imgProdutos: TImage;
    pnlVendas: TPanel;
    SpdbtnVendas: TSpeedButton;
    imgVendas: TImage;
    pnlClientes: TPanel;
    imgClientes: TImage;
    SpdbtnClientes: TSpeedButton;
    pnlFornecedores: TPanel;
    SpdbtnFornecedores: TSpeedButton;
    imgFornecedores: TImage;
    pnlItens: TPanel;
    shpItens: TShape;
    lblTotalItens: TLabel;
    pnlCategorias: TPanel;
    Label1: TLabel;
    totalCategorias: TLabel;
    shpCategorias: TShape;
    pnlEstoque: TPanel;
    spdbtnEstoque: TSpeedButton;
    imgEstoque: TImage;
    ADOConnectionGrid: TADOConnection;
    ADOQueryGrid: TADOQuery;
    DataSourceGrid: TDataSource;
    shpRemoverProduto: TShape;
    SpeedtbnRemoverProduto: TSpeedButton;
    DBGrid1: TDBGrid;
    procedure tmrTimer(Sender: TObject);
    procedure speedbtn_fecharClick(Sender: TObject);
    procedure FormActivate(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure SpdbtnInicioClick(Sender: TObject);
    procedure SpdbtnCriarProdutoClick(Sender: TObject);
    procedure SpdbtnVendasClick(Sender: TObject);
    procedure SpdbtnClientesClick(Sender: TObject);
    procedure SpdbtnFornecedoresClick(Sender: TObject);
    procedure spdbtnEstoqueClick(Sender: TObject);
    procedure SpeedtbnRemoverProdutoClick(Sender: TObject);



  private
    { Private declarations }
    procedure AtualizarEstoque;


  public
    { Public declarations }
  end;

var
  TelaProdutos: TTelaProdutos;

implementation

  uses uDMPrincipal, UnitGlobais, UnitTelaInicial, UnitCriarProduto, UnitTelaVendaspas, UnitTelaCliente, UnitTelaFornecedore,
  UnitTelaEstoque, UnitTelaRemoverProduto;

{$R *.dfm}



  // Processo para centralizar a tela
  procedure TTelaProdutos.FormActivate(Sender: TObject);
  begin

    pnlFundo.Left := Round ((TelaProdutos.Width - pnlFundo.Width)/2);
    pnlFundo.Top := Round ((TelaProdutos.Height- pnlFundo.Height)/2);

  end;


  // Processo para exibição do nome
  procedure TTelaProdutos.FormShow(Sender: TObject);
  var
    nomeFormatado:String;
    nomeMinusculo:String;
    nomeTitulo:String;

  begin
    nomeFormatado:= AnsiLowerCase(UsuarioLogado);
    nomeMinusculo:= AnsiLowerCase(Copy(UsuarioLogado, 2));
    nomeTitulo:= AnsiUpperCase(Copy(nomeFormatado, 1,1));
    lbl_nomeUsuario.Caption:= 'Olá, '+ nomeTitulo + nomeMinusculo +'!';

    AtualizarEstoque;



  end;


  // Processo para abrir a tela de cadastro de produtos
  procedure TTelaProdutos.SpdbtnClientesClick(Sender: TObject);
  begin
    telaCliente.show;
    telaProdutos.Hide;
  end;


  // Abrir a tela
  procedure TTelaProdutos.SpdbtnCriarProdutoClick(Sender: TObject);
  begin
    criarProduto.show;
  end;


  // Processo para abrir a tela de estoque
  procedure TTelaProdutos.spdbtnEstoqueClick(Sender: TObject);
  begin
    telaEstoque.show;
    telaProdutos.Hide;
  end;


  // Processo para abrir a tela de fornecedores
  procedure TTelaProdutos.SpdbtnFornecedoresClick(Sender: TObject);
  begin
    TelaFornecedor.show;
    TelaProdutos.Hide;
  end;


  // Processo para ir para a tela de inicio
  procedure TTelaProdutos.SpdbtnInicioClick(Sender: TObject);
  begin
    TelaInicial.Show;
    TelaProdutos.Hide;
  end;



  // Processo para abrir tela de vendas
  procedure TTelaProdutos.SpdbtnVendasClick(Sender: TObject);
  begin
    telaVendas.show;
    TelaProdutos.Hide;
  end;



  // Processo para terminar a aplicação
  procedure TTelaProdutos.speedbtn_fecharClick(Sender: TObject);
  begin
    Application.Terminate;
  end;



  procedure TTelaProdutos.SpeedtbnRemoverProdutoClick(Sender: TObject);
  begin
    telaRemoverProduto.show;
  end;


  // Processo para exibição da data e hora
  procedure TTelaProdutos.tmrTimer(Sender: TObject);
  var
    DataFormatada:String;
    HoraFormatada:String;

  begin
    //Formatação do dateTime para exibição no label
    DataFormatada:= FormatDateTime('dd "de" mmmm yyyy', date);
    HoraFormatada:= FormatDateTime('hh:nn', time);

    lbltime.Caption:=HoraFormatada;
    lbldate.Caption:=DataFormatada;
  end;



  procedure TTelaProdutos.AtualizarEstoque;
  begin
    // Exibição do label de total de itens cadastrados
    DMPrincipal.ADOQuery_contagem.Close;
    DMPrincipal.ADOQuery_contagem.Connection := DMPrincipal.ADOConnectionGeral;
    DMPrincipal.ADOQuery_contagem.SQL.Text := 'SELECT COUNT(*) AS total_itens FROM produtos';
    DMPrincipal.ADOQuery_contagem.Open;
    lblTotalItens.Caption := DMPrincipal.ADOQuery_contagem.FieldByName('total_itens').AsString;

    // Exibição do label de total de categorias
    DMPrincipal.ADOQuery_contagem.Close;
    DMPrincipal.ADOQuery_contagem.SQL.Text := 'SELECT COUNT(DISTINCT categoria) AS total_categorias FROM produtos';
    DMPrincipal.ADOQuery_contagem.Open;
    totalCategorias.Caption := DMPrincipal.ADOQuery_contagem.FieldByName('total_categorias').AsString;

  end;


end.
