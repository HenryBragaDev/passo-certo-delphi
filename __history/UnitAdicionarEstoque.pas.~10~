unit UnitAdicionarEstoque;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.DBCtrls, Vcl.StdCtrls, Vcl.Buttons,
  Vcl.ExtCtrls, Data.DB, Data.Win.ADODB;

type
  TTelaAdicionarEstoque = class(TForm)
    pnlFundo: TPanel;
    pnlborda: TPanel;
    shpCriarProduto: TShape;
    speedbtn_fechar: TSpeedButton;
    lblTitulo: TLabel;
    pnlItens: TPanel;
    lblProduto: TLabel;
    lblQuantidade: TLabel;
    lblCategoria: TLabel;
    lblPreco: TLabel;
    lblTamanho: TLabel;
    lblFornecedor: TLabel;
    shpSalvar: TShape;
    shpCancelar: TShape;
    SpeedbtnSalvar: TSpeedButton;
    SpeedbtnCancelar: TSpeedButton;
    shpCor: TShape;
    edtQuantidadeProduto: TEdit;
    edtTamanhoProduto: TEdit;
    edtPreco: TEdit;
    cbFornecedor: TDBLookupComboBox;
    cbCategoria: TDBLookupComboBox;
    cbProduto: TDBLookupComboBox;
    ADOQueryEstoque_Categorias: TADOQuery;
    DataSourceEstoque_Categorias: TDataSource;
    ADOQueryEstoque_Produtos: TADOQuery;
    DataSourceEstoque_Produtos: TDataSource;
    ADOQueryEstoque_Fornecedor: TADOQuery;
    DataSourceEstoque_Fornecedor: TDataSource;
    ADOQueryEstoque: TADOQuery;
    DataSourceEstoque: TDataSource;
    procedure speedbtn_fecharClick(Sender: TObject);
    procedure SpeedbtnCancelarClick(Sender: TObject);
    procedure FormActivate(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure cbCategoriaCloseUp(Sender: TObject);
    procedure cbProdutoCloseUp(Sender: TObject);
    procedure SpeedbtnSalvarClick(Sender: TObject);
    procedure edtQuantidadeProdutoKeyPress(Sender: TObject; var Key: Char);
    procedure edtPrecoKeyPress(Sender: TObject; var Key: Char);
    procedure edtTamanhoProdutoKeyPress(Sender: TObject; var Key: Char);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  TelaAdicionarEstoque: TTelaAdicionarEstoque;

implementation

{$R *.dfm}

  uses uDMPrincipal, UnitTelaEstoque;


  procedure TTelaAdicionarEstoque.cbCategoriaCloseUp(Sender: TObject);
  begin
  ADOQueryEstoque_Produtos.Close;
    ADOQueryEstoque_Produtos.SQL.Text :=
      'SELECT DISTINCT nome_produto FROM produtos WHERE categoria = ? ORDER BY nome_produto';
    ADOQueryEstoque_Produtos.Parameters.Refresh;
    ADOQueryEstoque_Produtos.Parameters[0].Value := cbCategoria.KeyValue;
    ADOQueryEstoque_Produtos.Open;

    cbProduto.ListSource := DataSourceEstoque_Produtos;
    cbProduto.ListField := 'nome_produto';
    cbProduto.KeyField := 'nome_produto';

    cbProduto.KeyValue := Null;
    cbFornecedor.KeyValue := Null;

  end;



  procedure TTelaAdicionarEstoque.cbProdutoCloseUp(Sender: TObject);
  begin
    ADOQueryEstoque_Fornecedor.Close;
    ADOQueryEstoque_Fornecedor.SQL.Text :=
      'SELECT DISTINCT fornecedor_produto FROM produtos WHERE nome_produto = ? ORDER BY fornecedor_produto';
    ADOQueryEstoque_Fornecedor.Parameters.Refresh;
    ADOQueryEstoque_Fornecedor.Parameters[0].Value := cbProduto.KeyValue;
    ADOQueryEstoque_Fornecedor.Open;

    cbFornecedor.ListSource := DataSourceEstoque_Fornecedor;
    cbFornecedor.ListField := 'fornecedor_produto';
    cbFornecedor.KeyField := 'fornecedor_produto';

    cbFornecedor.KeyValue := Null;
  end;



  procedure TTelaAdicionarEstoque.edtPrecoKeyPress(Sender: TObject;
  var Key: Char);
  begin
    if not (Key in ['0'..'9', ',', #8]) then
    Key := #0;
  end;



  procedure TTelaAdicionarEstoque.edtQuantidadeProdutoKeyPress(Sender: TObject;
  var Key: Char);
  begin
    if not (Key in ['0'..'9', #8]) then
    Key := #0;
  end;



  procedure TTelaAdicionarEstoque.edtTamanhoProdutoKeyPress(Sender: TObject;
  var Key: Char);
  begin
    if not (Key in ['0'..'9', #8]) then
    Key := #0;
  end;



  procedure TTelaAdicionarEstoque.FormActivate(Sender: TObject);
  begin
    pnlFundo.Left := Round ((TelaAdicionarEstoque.Width - pnlFundo.Width)/2);
    pnlFundo.Top := Round ((TelaAdicionarEstoque.Height - pnlFundo.Height)/2);
  end;



  procedure TTelaAdicionarEstoque.FormShow(Sender: TObject);
  begin
    ADOQueryEstoque_Categorias.Close;
    ADOQueryEstoque_Categorias.SQL.Text := 'SELECT DISTINCT categoria FROM produtos ORDER BY categoria';
    ADOQueryEstoque_Categorias.Open;

    cbCategoria.ListSource := DataSourceEstoque_Categorias;
    cbCategoria.ListField := 'categoria';
    cbCategoria.KeyField := 'categoria';

    cbCategoria.KeyValue := Null;
    cbProduto.KeyValue := Null;
    cbFornecedor.KeyValue := Null;
  end;



  procedure TTelaAdicionarEstoque.SpeedbtnCancelarClick(Sender: TObject);
  begin

    cbProduto.KeyValue := null;
    cbCategoria.KeyValue := null;
    cbFornecedor.KeyValue := null;
    edtTamanhoProduto.Clear;
    edtQuantidadeProduto.Clear;
    edtTamanhoProduto.Clear;
    edtPreco.Clear;

    telaAdicionarEstoque.Close;
  end;



  procedure TTelaAdicionarEstoque.SpeedbtnSalvarClick(Sender: TObject);
  var
    idProduto: Integer;
  begin
    if VarIsNull(cbCategoria.KeyValue) or
      VarIsNull(cbProduto.KeyValue) or
      VarIsNull(cbFornecedor.KeyValue) or
      (Trim(edtTamanhoProduto.Text) = '') or
      (Trim(edtQuantidadeProduto.Text) = '') or
      (Trim(edtPreco.Text) = '') then
  begin
    ShowMessage('Preencha todos os campos antes de salvar.');
    Exit;
  end;

  // Busca o ID do produto
  ADOQueryEstoque.Close;
  ADOQueryEstoque.SQL.Text :=
    'SELECT id_produto FROM produtos ' +
    'WHERE nome_produto = ? AND categoria = ? AND fornecedor_produto = ?';
  ADOQueryEstoque.Parameters.Refresh;
  ADOQueryEstoque.Parameters[0].Value := cbProduto.KeyValue;
  ADOQueryEstoque.Parameters[1].Value := cbCategoria.KeyValue;
  ADOQueryEstoque.Parameters[2].Value := cbFornecedor.KeyValue;
  ADOQueryEstoque.Open;

  if ADOQueryEstoque.IsEmpty then
  begin
    ShowMessage('Produto não encontrado!');
    Exit;
  end;

  idProduto := ADOQueryEstoque.FieldByName('id_produto').AsInteger;

  // Insere a variação
  ADOQueryEstoque.Close;
  ADOQueryEstoque.SQL.Text :=
    'INSERT INTO variacoes_produto ' +
    '(id_produto, tamanho_produto, preco, quantidade_produto, data_variacoes, produto, categoria_produto) ' +
    'VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP, ?, ?)';
  ADOQueryEstoque.Parameters.Refresh;
  ADOQueryEstoque.Parameters[0].Value := idProduto;
  ADOQueryEstoque.Parameters[1].Value := edtTamanhoProduto.Text;
  ADOQueryEstoque.Parameters[2].Value := StrToFloat(edtPreco.Text);
  ADOQueryEstoque.Parameters[3].Value := StrToInt(edtQuantidadeProduto.Text);
  ADOQueryEstoque.Parameters[4].Value := cbProduto.KeyValue;    // campo 'produto'
  ADOQueryEstoque.Parameters[5].Value := cbCategoria.KeyValue;  // campo 'categoria_produto'
  ADOQueryEstoque.ExecSQL;

  ShowMessage('Variação adicionada com sucesso!');

  TelaEstoque.ADOQueryGridEstoque.Requery;

  cbCategoria.KeyValue := Null;
  cbProduto.KeyValue := Null;
  cbFornecedor.KeyValue := Null;
  edtTamanhoProduto.Clear;
  edtQuantidadeProduto.Clear;
  edtPreco.Clear;
  end;



  procedure TTelaAdicionarEstoque.speedbtn_fecharClick(Sender: TObject);
  begin

    cbProduto.KeyValue := null;
    cbCategoria.KeyValue := null;
    cbFornecedor.KeyValue := null;
    edtTamanhoProduto.Clear;
    edtQuantidadeProduto.Clear;
    edtTamanhoProduto.Clear;
    edtPreco.Clear;

    telaAdicionarEstoque.Close;
  end;

end.
