unit UnitRemoverCliente;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.DBCtrls, Vcl.StdCtrls,
  Vcl.Buttons, Vcl.ExtCtrls, Data.DB, Data.Win.ADODB;

type
  TTelaRemoverCliente = class(TForm)
    pnlFundo: TPanel;
    pnlborda: TPanel;
    shpCriarProduto: TShape;
    speedbtn_fechar: TSpeedButton;
    lblTitulo: TLabel;
    pnlItens: TPanel;
    lblNome: TLabel;
    lbltelefone: TLabel;
    lblPreco: TLabel;
    shpSalvar: TShape;
    shpCancelar: TShape;
    SpeedbtnSalvar: TSpeedButton;
    SpeedbtnCancelar: TSpeedButton;
    shpCor: TShape;
    lblCategoria: TLabel;
    cbCliente: TDBLookupComboBox;
    cbEmail: TDBLookupComboBox;
    cbTelefone: TDBLookupComboBox;
    cbDataCadastro: TDBLookupComboBox;
    ADOQueryClienteNome: TADOQuery;
    DataSourceClienteNome: TDataSource;
    ADOQueryClienteEmail: TADOQuery;
    DataSourceClienteEmail: TDataSource;
    ADOQueryClienteTelefone: TADOQuery;
    DataSourceClienteTelefone: TDataSource;
    ADOQueryClienteData: TADOQuery;
    DataSourceClienteData: TDataSource;

    procedure FormActivate(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure SpeedbtnCancelarClick(Sender: TObject);
    procedure speedbtn_fecharClick(Sender: TObject);
    procedure cbClienteCloseUp(Sender: TObject);
    procedure cbEmailCloseUp(Sender: TObject);
    procedure cbTelefoneCloseUp(Sender: TObject);
    procedure SpeedbtnSalvarClick(Sender: TObject);

  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  TelaRemoverCliente: TTelaRemoverCliente;

implementation

{$R *.dfm}

  uses uDMPrincipal, UnitTelaCliente;

  procedure TTelaRemoverCliente.FormActivate(Sender: TObject);
  begin
    pnlFundo.Left := Round((TelaRemoverCliente.Width - pnlFundo.Width) / 2);
    pnlFundo.Top := Round((TelaRemoverCliente.Height - pnlFundo.Height) / 2);
  end;

  procedure TTelaRemoverCliente.FormShow(Sender: TObject);
  begin
    ADOQueryClienteNome.Close;
    ADOQueryClienteNome.SQL.Text :=
      'SELECT DISTINCT nome_cliente FROM clientes ORDER BY nome_cliente';
    ADOQueryClienteNome.Open;

    cbCliente.ListSource := DataSourceClienteNome;
    cbCliente.ListField  := 'nome_cliente';
    cbCliente.KeyField   := 'nome_cliente';

    cbEmail.KeyValue := Null;
    cbTelefone.KeyValue := Null;
    cbDataCadastro.KeyValue := Null;
  end;

  procedure TTelaRemoverCliente.cbClienteCloseUp(Sender: TObject);
  begin
    ADOQueryClienteEmail.Close;
    ADOQueryClienteEmail.SQL.Text :=
      'SELECT DISTINCT email FROM clientes WHERE nome_cliente = ? ORDER BY email';
    ADOQueryClienteEmail.Parameters.Refresh;
    ADOQueryClienteEmail.Parameters[0].DataType := ftString;
    ADOQueryClienteEmail.Parameters[0].Value := cbCliente.KeyValue;
    ADOQueryClienteEmail.Open;

    cbEmail.ListSource := DataSourceClienteEmail;
    cbEmail.ListField  := 'email';
    cbEmail.KeyField   := 'email';

    cbEmail.KeyValue := Null;
    cbTelefone.KeyValue := Null;
    cbDataCadastro.KeyValue := Null;
  end;

  procedure TTelaRemoverCliente.cbEmailCloseUp(Sender: TObject);
  begin
    ADOQueryClienteTelefone.Close;
    ADOQueryClienteTelefone.SQL.Text :=
      'SELECT DISTINCT telefone_cliente FROM clientes ' +
      'WHERE nome_cliente = ? AND email = ? ORDER BY telefone_cliente';
    ADOQueryClienteTelefone.Parameters.Refresh;
    ADOQueryClienteTelefone.Parameters[0].DataType := ftString;
    ADOQueryClienteTelefone.Parameters[1].DataType := ftString;
    ADOQueryClienteTelefone.Parameters[0].Value := cbCliente.KeyValue;
    ADOQueryClienteTelefone.Parameters[1].Value := cbEmail.KeyValue;
    ADOQueryClienteTelefone.Open;

    cbTelefone.ListSource := DataSourceClienteTelefone;
    cbTelefone.ListField  := 'telefone_cliente';
    cbTelefone.KeyField   := 'telefone_cliente';

    cbTelefone.KeyValue := Null;
    cbDataCadastro.KeyValue := Null;
  end;



  procedure TTelaRemoverCliente.cbTelefoneCloseUp(Sender: TObject);
  begin
      ADOQueryClienteData.Close;
    ADOQueryClienteData.SQL.Text :=
      'SELECT DISTINCT datacadastro FROM clientes ' +
      'WHERE nome_cliente = ? AND email = ? AND telefone_cliente = ? ' +
      'ORDER BY datacadastro';
    ADOQueryClienteData.Parameters.Refresh;
    ADOQueryClienteData.Parameters[0].DataType := ftString;
    ADOQueryClienteData.Parameters[1].DataType := ftString;
    ADOQueryClienteData.Parameters[2].DataType := ftString;
    ADOQueryClienteData.Parameters[0].Value := cbCliente.KeyValue;
    ADOQueryClienteData.Parameters[1].Value := cbEmail.KeyValue;
    ADOQueryClienteData.Parameters[2].Value := cbTelefone.KeyValue;
    ADOQueryClienteData.Open;

    cbDataCadastro.ListSource := DataSourceClienteData;
    cbDataCadastro.KeyField   := 'datacadastro';
    cbDataCadastro.ListField  := 'datacadastro';

    cbDataCadastro.KeyValue := null;
  end;



  procedure TTelaRemoverCliente.SpeedbtnCancelarClick(Sender: TObject);
  begin
    cbCliente.KeyValue := Null;
    cbEmail.KeyValue := Null;
    cbTelefone.KeyValue := Null;
    cbDataCadastro.KeyValue := Null;

    TelaRemoverCliente.Close;
  end;



  procedure TTelaRemoverCliente.SpeedbtnSalvarClick(Sender: TObject);
  var
  idCliente: Integer;
  begin
    // Verifica se todos os campos foram selecionados
    if VarIsNull(cbCliente.KeyValue) or
       VarIsNull(cbEmail.KeyValue) or
       VarIsNull(cbTelefone.KeyValue) or
       VarIsNull(cbDataCadastro.KeyValue) then
    begin
      ShowMessage('Preencha todos os campos antes de remover o cliente.');
      Exit;
    end;

    // Busca o ID do cliente
    DMPrincipal.ADOQueryBuscaCliente.Close;
    DMPrincipal.ADOQueryBuscaCliente.SQL.Text :=
      'SELECT id_cliente FROM clientes ' +
      'WHERE nome_cliente = ? AND email = ? AND telefone_cliente = ? AND datacadastro = ?';
    DMPrincipal.ADOQueryBuscaCliente.Parameters.Refresh;
    DMPrincipal.ADOQueryBuscaCliente.Parameters[0].DataType := ftString;
    DMPrincipal.ADOQueryBuscaCliente.Parameters[1].DataType := ftString;
    DMPrincipal.ADOQueryBuscaCliente.Parameters[2].DataType := ftString;
    DMPrincipal.ADOQueryBuscaCliente.Parameters[3].DataType := ftDateTime;
    DMPrincipal.ADOQueryBuscaCliente.Parameters[0].Value := cbCliente.KeyValue;
    DMPrincipal.ADOQueryBuscaCliente.Parameters[1].Value := cbEmail.KeyValue;
    DMPrincipal.ADOQueryBuscaCliente.Parameters[2].Value := cbTelefone.KeyValue;
    DMPrincipal.ADOQueryBuscaCliente.Parameters[3].Value := cbDataCadastro.KeyValue;
    DMPrincipal.ADOQueryBuscaCliente.Open;

    if DMPrincipal.ADOQueryBuscaCliente.IsEmpty then
    begin
      ShowMessage('Cliente não encontrado! Verifique os dados selecionados.');
      Exit;
    end;

    idCliente := DMPrincipal.ADOQueryBuscaCliente.FieldByName('id_cliente').AsInteger;

    // Confirmação
    if MessageDlg('Deseja realmente remover este cliente?', mtConfirmation, [mbYes, mbNo], 0) = mrNo then
      Exit;

    // Executa a exclusão
    DMPrincipal.ADOQueryRemoverCliente.Close;
    DMPrincipal.ADOQueryRemoverCliente.SQL.Text :=
      'DELETE FROM clientes WHERE id_cliente = ?';
    DMPrincipal.ADOQueryRemoverCliente.Parameters.Refresh;
    DMPrincipal.ADOQueryRemoverCliente.Parameters[0].DataType := ftInteger;
    DMPrincipal.ADOQueryRemoverCliente.Parameters[0].Value := idCliente;
    DMPrincipal.ADOQueryRemoverCliente.ExecSQL;

    ShowMessage('Cliente removido com sucesso!');

    // Atualiza o grid principal
    TelaCliente.ADOQueryGridClientes.Requery;

    // Limpa os campos
    cbCliente.KeyValue := Null;
    cbEmail.KeyValue := Null;
    cbTelefone.KeyValue := Null;
    cbDataCadastro.KeyValue := Null;

  end;



  procedure TTelaRemoverCliente.speedbtn_fecharClick(Sender: TObject);
  begin
    cbCliente.KeyValue := Null;
    cbEmail.KeyValue := Null;
    cbTelefone.KeyValue := Null;
    cbDataCadastro.KeyValue := Null;

    TelaRemoverCliente.Close;
  end;

end.
