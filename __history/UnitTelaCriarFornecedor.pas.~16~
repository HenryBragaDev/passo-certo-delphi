unit UnitTelaCriarFornecedor;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Buttons, Vcl.ExtCtrls;

type
  TtelaCriarFornecedor = class(TForm)
    pnlFundo: TPanel;
    pnlborda: TPanel;
    shpCriarProduto: TShape;
    speedbtn_fechar: TSpeedButton;
    lblTitulo: TLabel;
    pnlItens: TPanel;
    lblNome: TLabel;
    lblTelefone: TLabel;
    lblEmail: TLabel;
    lblTamanho: TLabel;
    lblCnpj: TLabel;
    shpSalvar: TShape;
    shpCancelar: TShape;
    SpeedbtnSalvar: TSpeedButton;
    SpeedbtnCancelar: TSpeedButton;
    shpCor: TShape;
    edtTelefone: TEdit;
    edtData: TEdit;
    edtNomeFornecedor: TEdit;
    edtemailFornecedor: TEdit;
    edtcnpjFornecedor: TEdit;
    procedure speedbtn_fecharClick(Sender: TObject);
    procedure SpeedbtnCancelarClick(Sender: TObject);
    procedure SpeedbtnSalvarClick(Sender: TObject);
    procedure FormActivate(Sender: TObject);
    procedure edtcnpjFornecedorKeyPress(Sender: TObject; var Key: Char);
    procedure edtTelefoneKeyPress(Sender: TObject; var Key: Char);
    procedure edtDataKeyPress(Sender: TObject; var Key: Char);



  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  telaCriarFornecedor: TtelaCriarFornecedor;

implementation

{$R *.dfm}

  uses uDMPrincipal;




  procedure TtelaCriarFornecedor.edtcnpjFornecedorKeyPress(Sender: TObject;
  var Key: Char);
  begin
    if not (Key in ['0'..'9', '.', '/', '-', #8]) then
      Key := #0;
  end;



  procedure TtelaCriarFornecedor.edtDataKeyPress(Sender: TObject; var Key: Char);
  begin
    if not (Key in ['0'..'9', '/', #8]) then
      Key := #0
  end;



  procedure TtelaCriarFornecedor.edtTelefoneKeyPress(Sender: TObject;
  var Key: Char);
  begin
    if not (Key in ['0'..'9', #8, '/', '-']) then
      Key := #0;
  end;



  procedure TtelaCriarFornecedor.FormActivate(Sender: TObject);
  begin
    pnlFundo.Left := Round ((TelaCriarFornecedor.Width - pnlFundo.Width)/2);
    pnlFundo.Top := Round ((TelaCriarFornecedor.Height - pnlFundo.Height)/2);
  end;



  procedure TtelaCriarFornecedor.SpeedbtnCancelarClick(Sender: TObject);
  begin
    telaCriarFornecedor.Close;

    edtNomeFornecedor.Clear;
    edtemailFornecedor.Clear;
    edtcnpjFornecedor.Clear;
    edtTelefone.Clear;
    edtData.Clear;

  end;



  procedure TtelaCriarFornecedor.SpeedbtnSalvarClick(Sender: TObject);
var
  nome, email, cnpj, telefone: string;
  dataCadastro: TDateTime;
begin
  // Captura e limpa espaços
  nome := Trim(edtNomeFornecedor.Text);
  email := Trim(edtemailFornecedor.Text);
  cnpj := Trim(edtcnpjFornecedor.Text);
  telefone := Trim(edtTelefone.Text);

  // Verifica campos obrigatórios
  if (nome = '') or (email = '') or (cnpj = '') or (telefone = '') then
  begin
    ShowMessage('Por favor, preencha todos os campos obrigatórios.');
    Exit;
  end;

  // Valida o formato do e-mail
  if (Pos('@', email) = 0) or (Pos('.', email) = 0) or
     (Pos('@', email) = Length(email)) then
  begin
    ShowMessage('E-mail inválido. Verifique e tente novamente.');
    Exit;
  end;

  try
    // Verifica se o CNPJ já existe
    DMPrincipal.ADOQueryVerificacaoFornecedores.Close;
    DMPrincipal.ADOQueryVerificacaoFornecedores.SQL.Text :=
      'SELECT COUNT(*) AS qtd FROM fornecedores WHERE cnpj_fornecedor = :cnpj';
    DMPrincipal.ADOQueryVerificacaoFornecedores.Parameters.ParamByName('cnpj').Value := cnpj;
    DMPrincipal.ADOQueryVerificacaoFornecedores.Open;

    if DMPrincipal.ADOQueryVerificacaoFornecedores.FieldByName('qtd').AsInteger > 0 then
    begin
      ShowMessage('CNPJ já cadastrado.');
      Exit;
    end;

    // Verifica se o e-mail já existe
    DMPrincipal.ADOQueryVerificacaoFornecedores.Close;
    DMPrincipal.ADOQueryVerificacaoFornecedores.SQL.Text :=
      'SELECT COUNT(*) AS qtd FROM fornecedores WHERE email_fornecedor = :email';
    DMPrincipal.ADOQueryVerificacaoFornecedores.Parameters.ParamByName('email').Value := email;
    DMPrincipal.ADOQueryVerificacaoFornecedores.Open;

    if DMPrincipal.ADOQueryVerificacaoFornecedores.FieldByName('qtd').AsInteger > 0 then
    begin
      ShowMessage('E-mail já cadastrado.');
      Exit;
    end;

    // Verifica se o telefone já existe
    DMPrincipal.ADOQueryVerificacaoFornecedores.Close;
    DMPrincipal.ADOQueryVerificacaoFornecedores.SQL.Text :=
      'SELECT COUNT(*) AS qtd FROM fornecedores WHERE telefone_fornecedor = :telefone';
    DMPrincipal.ADOQueryVerificacaoFornecedores.Parameters.ParamByName('telefone').Value := telefone;
    DMPrincipal.ADOQueryVerificacaoFornecedores.Open;

    if DMPrincipal.ADOQueryVerificacaoFornecedores.FieldByName('qtd').AsInteger > 0 then
    begin
      ShowMessage('Telefone já cadastrado.');
      Exit;
    end;

    dataCadastro := Now;

    DMPrincipal.ADOQueryFornecedores.Close;
    DMPrincipal.ADOQueryFornecedores.SQL.Clear;
    DMPrincipal.ADOQueryFornecedores.SQL.Add(
      'INSERT INTO fornecedores (nome_fornecedor, email_fornecedor, cnpj_fornecedor, telefone_fornecedor, data_cadastro) ' +
      'VALUES (:nome_fornecedor, :email_fornecedor, :cnpj_fornecedor, :telefone_fornecedor, :data_cadastro)'
    );
    DMPrincipal.ADOQueryFornecedores.Parameters.ParamByName('nome_fornecedor').Value := nome;
    DMPrincipal.ADOQueryFornecedores.Parameters.ParamByName('email_fornecedor').Value := email;
    DMPrincipal.ADOQueryFornecedores.Parameters.ParamByName('cnpj_fornecedor').Value := cnpj;
    DMPrincipal.ADOQueryFornecedores.Parameters.ParamByName('telefone_fornecedor').Value := telefone;
    DMPrincipal.ADOQueryFornecedores.Parameters.ParamByName('data_cadastro').Value := dataCadastro;
    DMPrincipal.ADOQueryFornecedores.ExecSQL;

    // Confirmação e limpeza dos campos
    ShowMessage('Fornecedor cadastrado com sucesso!');



    edtNomeFornecedor.Clear;
    edtemailFornecedor.Clear;
    edtcnpjFornecedor.Clear;
    edtTelefone.Clear;
    edtData.Clear;

  except
    on E: Exception do
      ShowMessage('Erro ao salvar fornecedor: ' + E.Message);
  end;

end;



  procedure TtelaCriarFornecedor.speedbtn_fecharClick(Sender: TObject);
  begin
    telaCriarFornecedor.Close;

    edtNomeFornecedor.Clear;
    edtemailFornecedor.Clear;
    edtcnpjFornecedor.Clear;
    edtTelefone.Clear;
    edtData.Clear;
  end;

end.
